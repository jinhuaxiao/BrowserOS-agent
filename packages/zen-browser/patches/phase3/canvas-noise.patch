+namespace {
+// Per-profile canvas pixel noise injection via MaskConfig.
+// Applies deterministic noise to RGB channels based on canvas seed,
+// making canvas fingerprint hashes differ between profiles.
+static void ApplyCanvasNoise(uint8_t* aData, uint32_t aSize) {
+  auto seedOpt = MaskConfig::GetUint32("fontSpacing:seed");
+  if (!seedOpt) return;
+  uint32_t seed = *seedOpt;
+  // Number of pixels to modify (subtle but sufficient for hash change)
+  uint32_t numPixels = aSize / 4;
+  if (numPixels == 0) return;
+  uint32_t modifications = std::min(numPixels / 4, uint32_t(200));
+  if (modifications < 20) modifications = 20;
+  for (uint32_t i = 0; i < modifications; ++i) {
+    seed = seed * 1664525u + 1013904223u;
+    uint32_t pixelIdx = (seed >> 8) % numPixels;
+    uint32_t channel = seed % 3;  // RGB only, skip alpha
+    uint32_t byteIdx = pixelIdx * 4 + channel;
+    if (byteIdx < aSize) {
+      seed = seed * 1664525u + 1013904223u;
+      aData[byteIdx] ^= (0x2 >> (seed & 0x1));  // XOR 1 or 2 LSB
+    }
+  }
+}
+}  // namespace

