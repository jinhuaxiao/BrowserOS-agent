diff --git a/dom/canvas/CanvasRenderingContext2D.cpp b/dom/canvas/CanvasRenderingContext2D.cpp
index xxxxxxxxxx..yyyyyyyyyy 100644
--- a/dom/canvas/CanvasRenderingContext2D.cpp
+++ b/dom/canvas/CanvasRenderingContext2D.cpp
@@ -6,6 +6,33 @@
 #include "CanvasRenderingContext2D.h"

 #include <algorithm>
+#include "MaskConfig.hpp"
+
+namespace {
+static void ApplyCanvasNoise(uint8_t* aData, uint32_t aWidth,
+                             uint32_t aHeight) {
+  if (!aData || aWidth == 0 || aHeight == 0) return;
+  if (aWidth > 32768 || aHeight > 32768) return;
+  auto seedOpt = MaskConfig::GetUint32("canvas:noiseSeed");
+  if (!seedOpt) return;
+  uint32_t seed = *seedOpt;
+  uint32_t aSize = aWidth * aHeight * 4;
+  uint32_t numPixels = aWidth * aHeight;
+  uint32_t modifications = std::min(numPixels / 4, uint32_t(200));
+  if (modifications < 1) modifications = 1;
+  for (uint32_t i = 0; i < modifications; ++i) {
+    seed = seed * 1664525u + 1013904223u;
+    uint32_t pixelIdx = (seed >> 8) % numPixels;
+    uint32_t channel = seed % 3;
+    uint32_t byteIdx = pixelIdx * 4 + channel;
+    if (byteIdx < aSize) {
+      seed = seed * 1664525u + 1013904223u;
+      aData[byteIdx] ^= (0x2 >> (seed & 0x1));
+    }
+  }
+}
+}  // namespace

 #include "CanvasImageCache.h"
 #include "CanvasUtils.h"
@@ -2288,6 +2315,9 @@
           out_imageSize->width * out_imageSize->height * 4,
           SurfaceFormat::A8R8G8B8_UINT32);
     }
+    // Per-profile canvas noise (independent of RFP setting)
+    ApplyCanvasNoise(ret.get(), out_imageSize->width, out_imageSize->height);
   }

   return ret;
@@ -6715,6 +6745,15 @@
     }
   } while (false);

+  // Per-profile canvas noise on the JS output buffer (writable)
+  {
+    JS::AutoCheckCannotGC nogc2;
+    bool isShared2;
+    uint8_t* jsData = JS_GetUint8ClampedArrayData(darray, &isShared2, nogc2);
+    if (jsData) {
+      ApplyCanvasNoise(jsData, aWidth, aHeight);
+    }
+  }
+
   readback->Unmap();
   *aRetval = darray;
   return NS_OK;
