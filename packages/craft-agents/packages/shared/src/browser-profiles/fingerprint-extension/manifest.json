{
  "manifest_version": 3,
  "name": "Fingerprint Guard",
  "version": "1.0.0",
  "description": "Browser fingerprint protection for anti-detection",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
