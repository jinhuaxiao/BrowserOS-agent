+void LocationBarView::UpdateProfileBadge() {
+  if (!profile_badge_) {
+    return;
+  }
+
+  // Get fingerprint config from the current browser context
+  content::BrowserContext* browser_context = browser_->profile();
+  if (!browser_context) {
+    profile_badge_->SetVisible(false);
+    return;
+  }
+
+  // Check if fingerprint config is available
+  const content::FingerprintConfig* config =
+      content::FingerprintConfig::GetInstance();
+
+  if (!config || config->profile_name.empty()) {
+    profile_badge_->SetVisible(false);
+    return;
+  }
+
+  // Update badge with profile info
+  profile_badge_->SetProfile(config->profile_name, config->profile_color);
+}
+
+void LocationBarView::OnWebContentsChanged() {
+  // ... existing code ...
+
+  // Update profile badge when web contents change
+  UpdateProfileBadge();
+}
