{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "overrides": [
    {
      "includes": [
        "packages/craft-agents/apps/electron/src/renderer/components/app-shell/AppShell.tsx",
        "packages/craft-agents/packages/shared/src/browser-profiles/launcher.ts",
        "packages/craft-agents/packages/shared/src/browser-profiles/zenctl.ts",
        "packages/craft-agents/apps/electron/src/shared/types.ts",
        "packages/craft-agents/packages/shared/src/browser-profiles/index.ts"
      ],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" },
          "a11y": {
            "noStaticElementInteractions": "off",
            "useButtonType": "off",
            "useFocusableInteractive": "off",
            "useSemanticElements": "off"
          },
          "style": { "noNonNullAssertion": "off" },
          "performance": { "noBarrelFile": "off" },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/browseros/chromium_patches/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": [
        "packages/zen-browser/patches/**",
        "packages/zen-browser/additions/**",
        "packages/camoufox/patches/**",
        "packages/camoufox/additions/**"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "a11y": {
        "noLabelWithoutControl": "warn"
      },
      "nursery": {
        "useSortedClasses": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 30
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
